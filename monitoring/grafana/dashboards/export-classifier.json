   "type": "timeseries",
   "title": "LLM retry rate",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "(sum(rate(llm_retries_total[1m])) or vector(0)) / clamp_min(sum(rate(llm_calls_total[1m])), 0.001)",
