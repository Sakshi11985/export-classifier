   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "sum(increase(llm_cost_usd_total[5m])) / clamp_min(sum(increase(agent_runs_total[5m])), 1)",
     "legendFormat": "USD per run",
     "refId": "A"
