# Copy to .env and edit:   cp .env.example .env
# Every environment-specific value is injected through the environment (D4). Nothing here is a real credential.
# docker compose reads .env automatically. Values in <angle brackets> must be supplied by you.

# ------------------------------------------------------------------ general
# label that appears in logs; compose sets it per service
SERVICE_NAME=app
# DEBUG|INFO|WARNING|ERROR
LOG_LEVEL=INFO

# ------------------------------------------------------------------ infrastructure
# queue, run store, caches, rate limits, traces. Compose hostname: redis
REDIS_URL=redis://redis:6379/0
# http (server container) | persistent (local folder) | ephemeral (tests)
CHROMA_MODE=http
# used when CHROMA_MODE=http
CHROMA_HOST=chroma
CHROMA_PORT=8000
# used when CHROMA_MODE=persistent; also where index_meta.json is written
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION=tariff

# ------------------------------------------------------------------ corpus + embeddings (L1, D2)
# folder with the three PDFs (text layer required, otherwise OCR first)
CORPUS_DIR=./corpus
# hashing: offline, deterministic, lexical only - works with zero downloads (first run / tests).
EMBEDDING_BACKEND=hashing
# sentence-transformers: semantic embeddings (production). Needs EMBEDDING_MODEL below and an image
# built with WITH_ST=1 (see README 'Semantic embeddings').
# only for sentence-transformers: the model name from section 12 of the course brief
EMBEDDING_MODEL=
# only for EMBEDDING_BACKEND=hashing
HASHING_EMBEDDING_DIM=512

# ------------------------------------------------------------------ language model (A5, L5)
# Switch with ONE command (edits .env, then restarts api + worker):
#   scripts/set_llm.sh offline | stub | real
# offline        deterministic reasoning policy, NOT a language model. Needs no key or network. Same agent graph,
#                tools and verifier. DEFAULT so that `docker compose up` from a clean clone always serves correct answers.
# openai_compat  ANY OpenAI-compatible /chat/completions API with tool calling: a provider free tier, Ollama,
#                or the bundled llm-stub (fixed vacuum-flask answers; load test + breaker demo only).
LLM_PROVIDER=offline
# active endpoint (set by scripts/set_llm.sh). The stub's compose address is shown
LLM_BASE_URL=http://llm-stub:8080/v1
# leave empty for the stub / local Ollama. Real key goes ONLY in your private .env
LLM_API_KEY=
# model id the provider documents. The stub accepts any name
LLM_MODEL_CLASSIFIER=stub-model
# verifier judge model; may equal the classifier model
LLM_MODEL_VERIFIER=stub-model
# --- your real provider (read only by scripts/set_llm.sh real; never committed with values)
# base URL of an OpenAI-compatible endpoint, e.g. the one your provider documents for "OpenAI compatibility"
REAL_LLM_BASE_URL=
REAL_LLM_API_KEY=
# copy the exact model id from the provider's console / model list
REAL_LLM_MODEL=
# optional: different model for the verifier judge
REAL_LLM_VERIFIER_MODEL=
# optional second provider used when the first is unavailable (before the offline policy)
REAL_LLM_FALLBACK_BASE_URL=
REAL_LLM_FALLBACK_API_KEY=
REAL_LLM_FALLBACK_MODEL=
# optional secondary provider, used when the primary is unavailable (before the offline policy)
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=
# timeout on every model call
LLM_TIMEOUT_S=20
# bounded retries (429/5xx/timeouts only)
LLM_MAX_RETRIES=2
# exponential backoff base, doubled per attempt, with jitter
LLM_BACKOFF_BASE_S=0.5
LLM_BACKOFF_MAX_S=8
# circuit breaker opens after this many failures ...
CB_FAILURE_THRESHOLD=5
# ... inside this window
CB_WINDOW_S=30
# stays open this long, then one probe call (half-open)
CB_RECOVERY_S=20
# USD per 1000 prompt tokens (cost accounting, L5). 0 = free tier
LLM_PRICE_PROMPT_PER_1K=0
# USD per 1000 completion tokens
LLM_PRICE_COMPLETION_PER_1K=0

# ------------------------------------------------------------------ agent loop bounds (A1)
# model calls per run
AGENT_MAX_STEPS=20
# tool calls per run
AGENT_MAX_TOOL_CALLS=30
# wall clock per run
AGENT_RUN_TIMEOUT_S=90
# timeout on every tool call
TOOL_TIMEOUT_S=10
# verify -> retry with a different strategy -> escalate
MAX_VERIFY_ATTEMPTS=2
# default|article_first|exhaustive_notes (baseline_single_pass is for ablation)
AGENT_FIRST_STRATEGY=default
# classifier prompt version (L2): v1|v2
PROMPT_VARIANT=v2
# true ONLY for the demonstration of verification (options.fault in the request)
ENABLE_FAULT_INJECTION=false

# ------------------------------------------------------------------ API / worker
# concurrent runs per worker container
WORKER_CONCURRENCY=4
# worker Prometheus endpoint
WORKER_METRICS_PORT=9101
# a worker silent for longer has its claimed runs re-queued
WORKER_HEARTBEAT_TTL_S=15
# how long run records are kept (7 days)
RUN_TTL_S=604800
# polling interval suggested to clients
POLL_AFTER_MS=700

# ------------------------------------------------------------------ caching and rate limiting (D7)
# whole-run cache keyed on request + index version + prompt variant + provider
RUN_CACHE_ENABLED=true
RETRIEVAL_CACHE_ENABLED=true
EMBEDDING_CACHE_ENABLED=true
CACHE_TTL_S=86400
# per client (X-Client-Id header, else IP): token bucket refill
RATE_LIMIT_PER_MIN=30
RATE_LIMIT_BURST=10
# unfinished runs per client
MAX_INFLIGHT_PER_CLIENT=20
# API answers 503 + Retry-After above this (backpressure)
MAX_QUEUE_DEPTH=500

# ------------------------------------------------------------------ observability (D5, L6)
# export spans via OTLP/HTTP
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
# fraction of live runs scored automatically against the eval metrics
LIVE_SCORE_SAMPLE_RATE=0.2
# declared SLO (docs/SLO.md); shown as a line on the dashboard
SLO_P95_SECONDS=20

# ------------------------------------------------------------------ compose only (not read by the app)
# build arg: 1 installs sentence-transformers and pre-downloads EMBEDDING_MODEL into the image
WITH_ST=0
# llm-stub delay per call (realistic provider latency for load tests)
STUB_DELAY_S=1.0
STUB_PORT=8080
# where the embedding model is cached inside the image
HF_HOME=/models
